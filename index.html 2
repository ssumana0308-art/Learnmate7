
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LearnMate 7</title>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f4ff;color:#292746}
header{background:#6558d3;color:white;text-align:center;padding:24px 12px}
main{max-width:760px;margin:auto;padding:16px}
.card{background:white;border-radius:16px;padding:20px;margin:16px 0;box-shadow:0 3px 12px #dedcf0}
h2{color:#5548b5}
button,.upload{background:#6558d3;color:white;border:0;border-radius:9px;padding:12px 16px;font-size:16px;cursor:pointer;display:inline-block;margin:5px 3px}
button:disabled{opacity:.5}
input[type=file]{max-width:100%;margin:12px 0}
textarea{width:100%;min-height:150px;padding:12px;border:1px solid #bbb;border-radius:8px;font:15px Arial}
#preview{max-width:100%;max-height:300px;display:block;margin:12px auto}
#status{white-space:pre-wrap;line-height:1.5}
.option{display:block;background:#f0efff;color:#292746;text-align:left;width:100%;margin:8px 0}
.option:disabled{opacity:1}
.correct{background:#d9f6df!important;color:#155724!important}
.wrong{background:#ffe0e0!important;color:#8b1b1b!important}
.small{color:#666;font-size:14px;line-height:1.5}
</style>
</head>
<body>
<header>
<h1>📚 LearnMate 7</h1>
<p>Upload. Understand. Practise. Improve.</p>
</header>
<main>
<section class="card">
<h2>1. Upload your textbook image</h2>
<p>Select a clear photo of a textbook page or your notes.</p>
<input id="image" type="file" accept="image/*">
<img id="preview" alt="Selected textbook image" hidden>
<button id="readBtn" disabled>Extract Text</button>
<p id="status" aria-live="polite">Choose an image to begin.</p>
</section>

<section class="card">
<h2>2. Check the extracted text</h2>
<p class="small">Correct any OCR mistakes before creating your quiz.</p>
<textarea id="text" placeholder="Your extracted text will appear here. You can also paste textbook text directly."></textarea>
<button id="quizBtn">Generate Practice Quiz</button>
</section>

<section class="card" id="quizArea" hidden>
<h2>3. Your Quiz</h2>
<p id="progress"></p>
<div id="question"></div>
<div id="feedback" aria-live="polite"></div>
<button id="nextBtn" hidden>Next Question →</button>
</section>
</main>

<script>
const imageInput = document.getElementById("image");
const preview = document.getElementById("preview");
const readBtn = document.getElementById("readBtn");
const status = document.getElementById("status");
const textBox = document.getElementById("text");
const quizBtn = document.getElementById("quizBtn");

imageInput.addEventListener("change", () => {
    const file = imageInput.files[0];
    if (!file) return;
    preview.src = URL.createObjectURL(file);
    preview.hidden = false;
    readBtn.disabled = false;
    status.textContent = "Image ready. Tap Extract Text.";
});

readBtn.addEventListener("click", async () => {
    const file = imageInput.files[0];
    if (!file) return;

    readBtn.disabled = true;
    status.textContent = "Reading image... Please wait.";

    try {
        const result = await Tesseract.recognize(file, "eng", {
            logger: message => {
                if (message.status === "recognizing text") {
                    status.textContent =
                        "Reading image: " +
                        Math.round(message.progress * 100) + "%";
                }
            }
        });
        textBox.value = result.data.text.trim();
        status.textContent = textBox.value
            ? "Text extracted! Check it for mistakes below."
            : "No readable text found. Try a clearer image.";
    } catch (error) {
        status.textContent =
            "Could not read the image. Check your internet connection and try again.";
    } finally {
        readBtn.disabled = false;
    }
});

let questions = [];
let current = 0;
let score = 0;
let answered = false;

function makeQuestions(source) {
    const sentences = source
        .replace(/\s+/g, " ")
        .match(/[^.!?\n]+[.!?]?/g) || [];

    const clean = sentences
        .map(s => s.trim())
        .filter(s => s.split(/\s+/).length >= 5);

    const stop = new Set([
        "which","where","their","there","these","those","about",
        "because","would","could","should","therefore","through",
        "while","after","before","under","between","above","below",
        "every","other","being","having","from","that","this",
        "with","into","were","been","have","will","your","they",
        "them","then","than","what","when","also","some","such",
        "more","most","very","each","many","much","does","doing",
        "used","using","only","over","both","same","upon"
    ]);

    const candidates = [];

    for (const sentence of clean) {
        const words = sentence.match(/[A-Za-z][A-Za-z'-]*/g) || [];
        const unique = [...new Set(words.filter(w =>
            w.length >= 5 && !stop.has(w.toLowerCase())
        ))];

        for (const word of unique) {
            const lower = word.toLowerCase();
            if (candidates.some(q => q.answer.toLowerCase() === lower))
                continue;

            const distractors = [...new Set(
                clean.join(" ").match(/[A-Za-z][A-Za-z'-]{4,}/g) || []
            )].filter(w =>
                w.toLowerCase() !== lower &&
                !stop.has(w.toLowerCase()) &&
                !unique.some(u => u.toLowerCase() === w.toLowerCase())
            );

            const shuffled = distractors.sort(() => Math.random() - 0.5);
            if (shuffled.length < 3) continue;

            candidates.push({
                sentence,
                answer: word,
                options: [word, ...shuffled.slice(0, 3)]
                    .sort(() => Math.random() - 0.5)
            });
        }
    }
    return candidates.slice(0, 10);
}

quizBtn.addEventListener("click", () => {
    const source = textBox.value.trim();

    if (source.length < 40) {
        alert("Please extract or enter more textbook text first.");
        return;
    }

    questions = makeQuestions(source);
    current = 0;
    score = 0;

    if (!questions.length) {
        alert("Not enough suitable text for a quiz. Please check the extracted text or add more content.");
        return;
    }

    document.getElementById("quizArea").hidden = false;
    showQuestion();
    document.getElementById("quizArea").scrollIntoView({
        behavior: "smooth"
    });
});

function showQuestion() {
    answered = false;
    const q = questions[current];

    document.getElementById("progress").textContent =
        "Question " + (current + 1) + " of " + questions.length +
        " · Score: " + score;

    document.getElementById("question").innerHTML = "";
    document.getElementById("feedback").textContent = "";
    document.getElementById("nextBtn").hidden = true;

    const title = document.createElement("h3");
    title.textContent = "Choose the word that appears in this sentence:";
    document.getElementById("question").appendChild(title);

    const sentence = document.createElement("p");
    sentence.textContent = q.sentence.replace(
        new RegExp("\\b" + q.answer.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\b", "i"),
        "______"
    );
    document.getElementById("question").appendChild(sentence);

    q.options.forEach(option => {
        const button = document.createElement("button");
        button.className = "option";
        button.textContent = option;
        button.addEventListener("click", () => checkAnswer(option, button));
        document.getElementById("question").appendChild(button);
    });
}

function checkAnswer(choice, selected) {
    if (answered) return;
    answered = true;

    const q = questions[current];
    const correct = choice.toLowerCase() === q.answer.toLowerCase();
    if (correct) score++;

    document.querySelectorAll(".option").forEach(button => {
        button.disabled = true;
        if (button.textContent.toLowerCase() === q.answer.toLowerCase()) {
            button.classList.add("correct");
        }
    });

    if (!correct) selected.classList.add("wrong");

    const feedback = document.getElementById("feedback");
    feedback.textContent = correct
        ? "Correct! 🎉 The answer matches the original sentence."
        : "Not quite. The correct answer is \"" + q.answer +
          "\". Here is the original sentence: " + q.sentence;
    feedback.style.marginTop = "14px";
    feedback.style.lineHeight = "1.6";

    document.getElementById("nextBtn").hidden = false;
    document.getElementById("nextBtn").textContent =
        current === questions.length - 1 ? "See Results" : "Next Question →";
}

document.getElementById("nextBtn").addEventListener("click", () => {
    if (current < questions.length - 1) {
        current++;
        showQuestion();
    } else {
        document.getElementById("question").textContent =
            "Quiz completed! You scored " + score + " out of " +
            questions.length + ".";
        document.getElementById("progress").textContent = "Your Results";
        document.getElementById("feedback").textContent =
            score === questions.length
                ? "Excellent work! 🌟"
                : "Review the textbook text and try again to improve your score.";
        document.getElementById("nextBtn").hidden = true;
    }
});
</script>
</body>
</html>
